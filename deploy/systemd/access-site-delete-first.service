[Unit]
Description=Back up VPN nodes and run confirmed delete-first replacements
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/access-site/infrastructure.json

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/access-site/current
EnvironmentFile=/etc/access-site/site.env
EnvironmentFile=-/etc/access-site/infrastructure.env
UnsetEnvironment=VDSINA_SOCKS_PROXY
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/access-site/current/venv/bin/python /opt/nodeguard-control/deploy/delete-first.py
UMask=0077
TimeoutStartSec=18min
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
